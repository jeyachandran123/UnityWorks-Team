#!/usr/bin/env bash
# Hook tests. Each case pipes a PreToolUse/PostToolUse payload into a hook and
# asserts its exit code. Exit 2 means "block"; exit 0 means "allow".
#
# Run: bash tests/run-tests

set -uo pipefail

HOOKS="$(cd "$(dirname "$0")/../hooks" && pwd)"
pass=0
fail=0

# expect <name> <expected-exit> <script> <json-payload>
expect() {
    local name="$1" want="$2" script="$3" payload="$4"
    local got
    printf '%s' "$payload" | bash "${HOOKS}/${script}" >/dev/null 2>&1
    got=$?
    if [ "$got" -eq "$want" ]; then
        printf 'ok   %s\n' "$name"
        pass=$((pass + 1))
    else
        printf 'FAIL %s (expected exit %s, got %s)\n' "$name" "$want" "$got"
        fail=$((fail + 1))
    fi
}

# expect_output <name> <expected-substring-or-empty> <script> <json-payload>
# Asserts on the hook's combined stdout+stderr. An empty expected string means
# the hook must print nothing at all.
expect_output() {
    local name="$1" want="$2" script="$3" payload="$4"
    local out
    out="$(printf '%s' "$payload" | bash "${HOOKS}/${script}" 2>&1)"
    if [ -z "$want" ]; then
        if [ -z "$out" ]; then
            printf 'ok   %s\n' "$name"; pass=$((pass + 1)); return
        fi
        printf 'FAIL %s (expected no output, got: %s)\n' "$name" "$out"; fail=$((fail + 1)); return
    fi
    case "$out" in
        *"$want"*) printf 'ok   %s\n' "$name"; pass=$((pass + 1)) ;;
        *) printf 'FAIL %s (output did not contain %s)\n' "$name" "$want"; fail=$((fail + 1)) ;;
    esac
}

# expect_via_launcher <name> <expected-exit> <script> <json-payload>
# Same as expect, but drives the payload through hooks/run-hook.cmd — the
# polyglot launcher every product repo's settings.json actually invokes —
# instead of calling the hook script directly. Run under bash this only
# exercises the launcher's Unix fallthrough half (the bottom `exec bash ...`
# line), not the cmd.exe half where C1 lives, but it still proves the
# launcher dispatches to the right script and propagates its exit code
# rather than swallowing it.
expect_via_launcher() {
    local name="$1" want="$2" script="$3" payload="$4"
    local got
    printf '%s' "$payload" | bash "${HOOKS}/run-hook.cmd" "$script" >/dev/null 2>&1
    got=$?
    if [ "$got" -eq "$want" ]; then
        printf 'ok   %s\n' "$name"
        pass=$((pass + 1))
    else
        printf 'FAIL %s (expected exit %s, got %s)\n' "$name" "$want" "$got"
        fail=$((fail + 1))
    fi
}

# ---- secret-guard ---------------------------------------------------------

expect "secret-guard blocks a write to .env" 2 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/.env","content":"X=1"}}'

expect "secret-guard blocks an AWS key in content" 2 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/config.py","content":"KEY = \"AKIAIOSFODNN7EXAMPLE\""}}'

expect "secret-guard blocks a long hex secret" 2 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/x.py","content":"SECRET_KEY = \"0123456789abcdef0123456789abcdef0123456789abcdef\""}}'

expect "secret-guard allows .env.example" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/.env.example","content":"SECRET_KEY=changeme"}}'

expect "secret-guard allows ordinary source" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/main.py","content":"def run(): pass"}}'

# A secret-shaped keyword appearing only as a substring of a descriptive
# identifier must not block — these are real fixture/build content, not
# leaked secrets, and over-blocking them is what gets a guard disabled.
expect "secret-guard allows a hash assigned to a descriptively-named field" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/tests/fixtures/auth.py","content":"expected_password_hash = \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""}}'

expect "secret-guard allows a commit hash assigned to BUILD_TOKEN" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/scripts/build.py","content":"BUILD_TOKEN = \"a7dcf87dbefa45a710fdce1844c7bc20abc5953b\""}}'

expect "secret-guard allows a TypeScript import" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/frontend/src/index.ts","content":"import { LongDescriptiveComponentNameForRouting } from \"../components/shared/layout\""}}'

expect "secret-guard allows an unnamed long base64 asset string" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/assets.py","content":"ASSET_DATA = \"aGVsbG93b3JsZGhlbGxvd29ybGRoZWxsb3dvcmxkaGVsbG93b3JsZA==\""}}'

expect "secret-guard allows a short api_key" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/config.py","content":"api_key = \"short123\""}}'

expect_via_launcher "secret-guard blocks a write to .env through run-hook.cmd" 2 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/.env","content":"X=1"}}'

# ---- contract-reminder ----------------------------------------------------

expect_output "contract-reminder names the export command on a route edit" "export_openapi" contract-reminder \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/app/api/product.py"}}'

expect_output "contract-reminder is silent outside app/api" "" contract-reminder \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/app/domain/incidents.py"}}'

# Claude Code on Windows supplies native backslash absolute paths, not the
# forward-slash paths above. The case patterns must normalise separators
# before matching or this fires silently (C2).
expect_output "contract-reminder names the export command on a Windows backslash route edit" "export_openapi" contract-reminder \
    '{"tool_name":"Edit","tool_input":{"file_path":"C:\\Users\\Jayachandran\\ProjectsAndDocs\\atlas\\unityworks-vision-ai-backend\\app\\api\\product.py"}}'

# ---- protected-tree -------------------------------------------------------

expect "protected-tree blocks a vision_os edit" 2 protected-tree \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/vision_os/kernel/runtime.py"}}'

expect "protected-tree blocks a compliance edit" 2 protected-tree \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/compliance/evaluator.py"}}'

expect "protected-tree allows an app edit" 0 protected-tree \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/app/vision/manager.py"}}'

expect "protected-tree allows a test edit" 0 protected-tree \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/tests/app/test_reports.py"}}'

# Windows backslash absolute path, as Claude Code actually supplies on this
# platform (C2). Before the separator-normalisation fix this fell through
# every case pattern silently and returned 0.
expect "protected-tree blocks a vision_os edit with a Windows backslash path" 2 protected-tree \
    '{"tool_name":"Edit","tool_input":{"file_path":"C:\\Users\\Jayachandran\\ProjectsAndDocs\\atlas\\unityworks-vision-ai-backend\\vision_os\\kernel\\runtime.py"}}'

expect_via_launcher "protected-tree blocks a vision_os edit through run-hook.cmd" 2 protected-tree \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/vision_os/kernel/runtime.py"}}'

# ---- destructive-bash -----------------------------------------------------

expect "destructive-bash blocks alembic downgrade" 2 destructive-bash \
    '{"tool_name":"Bash","tool_input":{"command":"alembic downgrade -1"}}'

expect "destructive-bash blocks a force push" 2 destructive-bash \
    '{"tool_name":"Bash","tool_input":{"command":"git push --force origin main"}}'

# Bare `git push -f` (no explicit remote/branch — pushes the tracked
# upstream) has no trailing space after "-f", so a pattern requiring one
# missed it (I3). It is exactly as destructive as the explicit form below.
expect "destructive-bash blocks a bare git push -f" 2 destructive-bash \
    '{"tool_name":"Bash","tool_input":{"command":"git push -f"}}'

expect "destructive-bash blocks discarding the tree" 2 destructive-bash \
    '{"tool_name":"Bash","tool_input":{"command":"git checkout -- ."}}'

expect "destructive-bash allows alembic upgrade" 0 destructive-bash \
    '{"tool_name":"Bash","tool_input":{"command":"alembic upgrade head"}}'

expect "destructive-bash allows an ordinary push" 0 destructive-bash \
    '{"tool_name":"Bash","tool_input":{"command":"git push origin feat/x"}}'

expect_via_launcher "destructive-bash blocks alembic downgrade through run-hook.cmd" 2 destructive-bash \
    '{"tool_name":"Bash","tool_input":{"command":"alembic downgrade -1"}}'

# ---- generated-file -------------------------------------------------------

expect "generated-file blocks a hand-edit of openapi.ts" 2 generated-file \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/src/shared/types/openapi.ts"}}'

expect "generated-file allows other shared types" 0 generated-file \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/src/shared/types/index.ts"}}'

expect "generated-file allows the generator itself" 0 generated-file \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/scripts/generate-types.mjs"}}'

# Windows backslash absolute path (C2). Before the fix the literal-slash
# case pattern never matched this and the hand-edit sailed through.
expect "generated-file blocks a Windows backslash path to openapi.ts" 2 generated-file \
    '{"tool_name":"Edit","tool_input":{"file_path":"C:\\Users\\Jayachandran\\ProjectsAndDocs\\atlas\\unityworks-vision-ai-frontend\\src\\shared\\types\\openapi.ts"}}'

expect_via_launcher "generated-file blocks openapi.ts through run-hook.cmd" 2 generated-file \
    '{"tool_name":"Edit","tool_input":{"file_path":"/repo/src/shared/types/openapi.ts"}}'

# ---------------------------------------------------------------------------

printf '\n%s passed, %s failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
