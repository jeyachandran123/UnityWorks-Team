#!/usr/bin/env bash
# Hook tests. Each case pipes a PreToolUse/PostToolUse/Stop payload into a hook
# and asserts its exit code or output. Exit 2 means "block"; exit 0 "allow".
#
# Run: bash tests/run-tests

set -uo pipefail

HOOKS="$(cd "$(dirname "$0")/../hooks" && pwd)"
pass=0
fail=0

# ---- fixtures -------------------------------------------------------------
#
# Path guards scope themselves by the repository a file lives in, identified by
# marker files, so the fixtures are real directories rather than "/repo/..."
# strings: a backend (vision_os/ + scripts/export_openapi.py), a frontend
# (scripts/generate-types.mjs) and an unrelated repository that also has a
# tools/ and a src/shared/types/openapi.ts — which no guard may touch.

FIX="$(mktemp -d)"
trap 'rm -rf "$FIX"' EXIT

BACKEND="$FIX/unityworks-vision-ai-backend"
FRONTEND="$FIX/unityworks-vision-ai-frontend"
OTHER="$FIX/other-project"

mkdir -p "$BACKEND/.git" "$BACKEND/vision_os" "$BACKEND/scripts" \
         "$FRONTEND/.git" "$FRONTEND/scripts" \
         "$OTHER/.git" "$OTHER/tools" "$OTHER/scripts"
touch "$BACKEND/scripts/export_openapi.py" "$FRONTEND/scripts/generate-types.mjs"
SCRATCH="$FIX/scratch/unityworks-vision-ai-backend"   # as made by scratch-copy
mkdir -p "$SCRATCH/vision_os" && touch "$SCRATCH/.unityworks-scratch-copy"

# win <posix-path> — the path as Claude Code on Windows puts it on the wire:
# native backslashes, each doubled by JSON escaping. Empty when cygpath is
# unavailable (non-Windows), and the Windows cases are then skipped.
win() {
    command -v cygpath >/dev/null 2>&1 || return 0
    cygpath -w "$1" | sed 's/\\/\\\\/g'
}

edit_payload() { printf '{"tool_name":"Edit","tool_input":{"file_path":"%s"}}' "$1"; }
bash_payload() { printf '{"tool_name":"Bash","tool_input":{"command":"%s"}}' "$1"; }

# ---- assertions -----------------------------------------------------------

# expect <name> <expected-exit> <script> <json-payload>
expect() {
    local name="$1" want="$2" script="$3" payload="$4"
    local got
    printf '%s' "$payload" | bash "${HOOKS}/${script}" >/dev/null 2>&1
    got=$?
    report "$name" "$want" "$got"
}

# expect_via_launcher <name> <expected-exit> <script> <json-payload>
# Drives the payload through hooks/run-hook.cmd, the launcher hooks.json
# invokes. Under bash this exercises only the launcher's Unix fallthrough half,
# but it proves dispatch to the right script and exit-code propagation.
expect_via_launcher() {
    local name="$1" want="$2" script="$3" payload="$4"
    local got
    printf '%s' "$payload" | bash "${HOOKS}/run-hook.cmd" "$script" >/dev/null 2>&1
    got=$?
    report "$name" "$want" "$got"
}

report() {
    if [ "$3" -eq "$2" ]; then
        printf 'ok   %s\n' "$1"; pass=$((pass + 1))
    else
        printf 'FAIL %s (expected exit %s, got %s)\n' "$1" "$2" "$3"; fail=$((fail + 1))
    fi
}

# expect_output <name> <expected-substring-or-empty> <script> <json-payload>
# Asserts on combined stdout+stderr. An empty expectation means "prints nothing".
expect_output() {
    local name="$1" want="$2" script="$3" payload="$4"
    local out
    out="$(printf '%s' "$payload" | bash "${HOOKS}/${script}" 2>&1)"
    if [ -z "$want" ]; then
        if [ -z "$out" ]; then
            printf 'ok   %s\n' "$name"; pass=$((pass + 1)); return
        fi
        printf 'FAIL %s (expected no output, got: %s)\n' "$name" "$out"; fail=$((fail + 1)); return
    fi
    case "$out" in
        *"$want"*) printf 'ok   %s\n' "$name"; pass=$((pass + 1)) ;;
        *) printf 'FAIL %s (output did not contain %s)\n' "$name" "$want"; fail=$((fail + 1)) ;;
    esac
}

skip() { printf 'skip %s (no cygpath)\n' "$1"; }

# ---- hooks.json -----------------------------------------------------------

# Every command hooks.json registers must name a script that exists, or that
# hook fails open without a word.
for script in $(grep -o 'run-hook.cmd\\" [a-z-]*' "$HOOKS/hooks.json" | awk '{print $2}'); do
    if [ -f "$HOOKS/$script" ]; then
        report "hooks.json names an existing script: $script" 0 0
    else
        report "hooks.json names an existing script: $script" 0 1
    fi
done

# ---- secret-guard ---------------------------------------------------------

expect "secret-guard blocks a write to .env" 2 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/.env","content":"X=1"}}'

expect "secret-guard blocks an AWS key in content" 2 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/config.py","content":"KEY = \"AKIAIOSFODNN7EXAMPLE\""}}'

expect "secret-guard blocks a long hex secret" 2 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/x.py","content":"SECRET_KEY = \"0123456789abcdef0123456789abcdef0123456789abcdef\""}}'

expect "secret-guard allows .env.example" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/.env.example","content":"SECRET_KEY=changeme"}}'

expect "secret-guard allows ordinary source" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/main.py","content":"def run(): pass"}}'

# A secret-shaped keyword appearing only as a substring of a descriptive
# identifier must not block — over-blocking is what gets a guard disabled.
expect "secret-guard allows a hash assigned to a descriptively-named field" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/tests/fixtures/auth.py","content":"expected_password_hash = \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\""}}'

expect "secret-guard allows a commit hash assigned to BUILD_TOKEN" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/scripts/build.py","content":"BUILD_TOKEN = \"a7dcf87dbefa45a710fdce1844c7bc20abc5953b\""}}'

expect "secret-guard allows a TypeScript import" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/frontend/src/index.ts","content":"import { LongDescriptiveComponentNameForRouting } from \"../components/shared/layout\""}}'

expect "secret-guard allows an unnamed long base64 asset string" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/assets.py","content":"ASSET_DATA = \"aGVsbG93b3JsZGhlbGxvd29ybGRoZWxsb3dvcmxkaGVsbG93b3JsZA==\""}}'

expect "secret-guard allows a short api_key" 0 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/config.py","content":"api_key = \"short123\""}}'

expect_via_launcher "secret-guard blocks a write to .env through run-hook.cmd" 2 secret-guard \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/.env","content":"X=1"}}'

# ---- contract-reminder ----------------------------------------------------

expect_output "contract-reminder names the export command on a route edit" "export_openapi" contract-reminder \
    "$(edit_payload "$BACKEND/app/api/product.py")"

expect_output "contract-reminder is silent outside app/api" "" contract-reminder \
    "$(edit_payload "$BACKEND/app/domain/incidents.py")"

expect_output "contract-reminder is silent for app/api in an unrelated repository" "" contract-reminder \
    "$(edit_payload "$OTHER/app/api/routes.py")"

if [ -n "$(win "$BACKEND")" ]; then
    expect_output "contract-reminder fires on a Windows backslash route edit" "export_openapi" contract-reminder \
        "$(edit_payload "$(win "$BACKEND")\\\\app\\\\api\\\\product.py")"
else
    skip "contract-reminder fires on a Windows backslash route edit"
fi

# ---- protected-tree -------------------------------------------------------

expect "protected-tree blocks a vision_os edit" 2 protected-tree \
    "$(edit_payload "$BACKEND/vision_os/kernel/runtime.py")"

expect "protected-tree blocks a compliance edit" 2 protected-tree \
    "$(edit_payload "$BACKEND/compliance/evaluator.py")"

expect "protected-tree blocks a tools edit" 2 protected-tree \
    "$(edit_payload "$BACKEND/tools/vision_eval/metrics.py")"

expect "protected-tree allows an app edit" 0 protected-tree \
    "$(edit_payload "$BACKEND/app/vision/manager.py")"

expect "protected-tree allows tests/vision_os" 0 protected-tree \
    "$(edit_payload "$BACKEND/tests/vision_os/architecture/test_boundaries.py")"

expect "protected-tree ignores tools/ in an unrelated repository" 0 protected-tree \
    "$(edit_payload "$OTHER/tools/build.py")"

expect "protected-tree allows a file outside any repository" 0 protected-tree \
    "$(edit_payload "$FIX/loose/vision_os/x.py")"

if [ -n "$(win "$BACKEND")" ]; then
    expect "protected-tree blocks a vision_os edit with a Windows backslash path" 2 protected-tree \
        "$(edit_payload "$(win "$BACKEND")\\\\vision_os\\\\kernel\\\\runtime.py")"
else
    skip "protected-tree blocks a vision_os edit with a Windows backslash path"
fi

expect_via_launcher "protected-tree blocks a vision_os edit through run-hook.cmd" 2 protected-tree \
    "$(edit_payload "$BACKEND/vision_os/kernel/runtime.py")"

# ---- destructive-bash -----------------------------------------------------

expect "destructive-bash blocks alembic downgrade" 2 destructive-bash "$(bash_payload "alembic downgrade -1")"
expect "destructive-bash blocks a force push" 2 destructive-bash "$(bash_payload "git push --force origin main")"
# Bare `git push -f` has no trailing space after "-f"; a pattern requiring one missed it.
expect "destructive-bash blocks a bare git push -f" 2 destructive-bash "$(bash_payload "git push -f")"
expect "destructive-bash blocks discarding the tree" 2 destructive-bash "$(bash_payload "git checkout -- .")"
expect "destructive-bash blocks git clean -fd" 2 destructive-bash "$(bash_payload "git clean -fd")"
expect "destructive-bash blocks docker compose down" 2 destructive-bash "$(bash_payload "docker compose down -v")"
expect "destructive-bash blocks through a PowerShell payload" 2 destructive-bash \
    '{"tool_name":"PowerShell","tool_input":{"command":"git reset --hard HEAD~1"}}'
expect "destructive-bash allows alembic upgrade" 0 destructive-bash "$(bash_payload "alembic upgrade head")"
expect "destructive-bash allows an ordinary push" 0 destructive-bash "$(bash_payload "git push origin feat/x")"
expect "destructive-bash allows docker compose up" 0 destructive-bash "$(bash_payload "docker compose up -d postgres")"

expect_via_launcher "destructive-bash blocks alembic downgrade through run-hook.cmd" 2 destructive-bash \
    "$(bash_payload "alembic downgrade -1")"

# ---- generated-file -------------------------------------------------------

expect "generated-file blocks a hand-edit of openapi.ts" 2 generated-file \
    "$(edit_payload "$FRONTEND/src/shared/types/openapi.ts")"

expect "generated-file allows other shared types" 0 generated-file \
    "$(edit_payload "$FRONTEND/src/shared/types/index.ts")"

expect "generated-file allows the generator itself" 0 generated-file \
    "$(edit_payload "$FRONTEND/scripts/generate-types.mjs")"

expect "generated-file ignores openapi.ts in an unrelated repository" 0 generated-file \
    "$(edit_payload "$OTHER/src/shared/types/openapi.ts")"

if [ -n "$(win "$FRONTEND")" ]; then
    expect "generated-file blocks a Windows backslash path to openapi.ts" 2 generated-file \
        "$(edit_payload "$(win "$FRONTEND")\\\\src\\\\shared\\\\types\\\\openapi.ts")"
else
    skip "generated-file blocks a Windows backslash path to openapi.ts"
fi

expect_via_launcher "generated-file blocks openapi.ts through run-hook.cmd" 2 generated-file \
    "$(edit_payload "$FRONTEND/src/shared/types/openapi.ts")"

# ---- agent-scope ----------------------------------------------------------

agent_write() { printf '{"agent_type":"%s","tool_name":"Write","tool_input":{"file_path":"%s","content":"x"}}' "$1" "$2"; }
agent_bash() { printf '{"agent_type":"%s","tool_name":"Bash","tool_input":{"command":"%s"}}' "$1" "$2"; }

expect "agent-scope lets a specialist file its report" 0 agent-scope \
    "$(agent_write unityworks-team:security-engineer "$BACKEND/docs/reviews/2026-09-17/security-engineer.md")"
expect "agent-scope blocks a specialist writing source" 2 agent-scope \
    "$(agent_write unityworks-team:security-engineer "$BACKEND/app/auth/tokens.py")"
expect "agent-scope blocks a specialist editing source" 2 agent-scope \
    '{"agent_type":"unityworks-team:qa-engineer","tool_name":"Edit","tool_input":{"file_path":"/repo/tests/app/test_x.py"}}'
expect "agent-scope allows a mutation inside a scratch copy" 0 agent-scope \
    "$(agent_write unityworks-team:architecture-auditor "$SCRATCH/vision_os/x.py")"
expect "agent-scope blocks a specialist committing" 2 agent-scope \
    "$(agent_bash unityworks-team:backend-engineer "git add -A && git commit -m x")"
expect "agent-scope blocks a specialist installing" 2 agent-scope \
    "$(agent_bash unityworks-team:frontend-engineer "npm install left-pad")"
expect "agent-scope blocks a specialist creating a worktree" 2 agent-scope \
    "$(agent_bash unityworks-team:qa-engineer "git worktree add ../_audit HEAD")"
expect "agent-scope blocks alembic upgrade on the configured database" 2 agent-scope \
    "$(agent_bash unityworks-team:devops-engineer ".venv/Scripts/python.exe -m alembic upgrade head")"
expect "agent-scope allows alembic upgrade on a disposable sqlite file" 0 agent-scope \
    "$(agent_bash unityworks-team:devops-engineer "DATABASE_URL_OVERRIDE=sqlite+aiosqlite:///C:/tmp/x/check.db .venv/Scripts/python.exe -m alembic upgrade head")"
expect "agent-scope lets a specialist run tests and read history" 0 agent-scope \
    "$(agent_bash unityworks-team:qa-engineer "git log --oneline -5 && .venv/Scripts/python.exe -m pytest tests/app")"
expect "agent-scope accepts an unqualified roster name" 2 agent-scope \
    "$(agent_write tech-lead "$BACKEND/app/main.py")"
expect "agent-scope leaves the main session alone" 0 agent-scope \
    '{"tool_name":"Write","tool_input":{"file_path":"/repo/app/auth/tokens.py","content":"x"}}'
expect "agent-scope leaves other agents alone" 0 agent-scope \
    "$(agent_bash general-purpose "git commit -m x")"
expect_via_launcher "agent-scope blocks through run-hook.cmd" 2 agent-scope \
    "$(agent_write unityworks-team:security-engineer "$BACKEND/app/auth/tokens.py")"

# ---- verify-gate ----------------------------------------------------------
#
# Transcripts are JSONL with one message per line; only the tool_use fragments
# the gate greps for are reproduced. Line order is what matters: a gate command
# counts only if it appears after the last gated edit.

tx() {  # tx <name> <line>... — write a transcript, print its path
    local f="$FIX/$1.jsonl"; shift
    printf '%s\n' "$@" > "$f"
    printf '%s' "$f"
}
t_edit() { printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t","name":"Edit","input":{"file_path":"%s","old_string":"a"}}]}}' "$1"; }
t_bash() { printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t","name":"Bash","input":{"command":"%s","description":"d"}}]}}' "$1"; }
stop_payload() { printf '{"session_id":"s","transcript_path":"%s","stop_hook_active":%s}' "$1" "${2:-false}"; }

T="$(tx backend-unverified "$(t_edit "$BACKEND/app/domain/audit.py")")"
expect "verify-gate blocks a backend edit with no gate run" 2 verify-gate "$(stop_payload "$T")"
expect_output "verify-gate names pytest when it never ran" "pytest" verify-gate "$(stop_payload "$T")"

T="$(tx backend-verified \
    "$(t_edit "$BACKEND/app/domain/audit.py")" \
    "$(t_bash 'cd \\\"x\\\" && ruff check app tests && black --check app tests && pytest')")"
expect "verify-gate allows a backend edit followed by the gate" 0 verify-gate "$(stop_payload "$T")"

T="$(tx backend-stale \
    "$(t_bash "ruff check app tests && black --check app tests && pytest")" \
    "$(t_edit "$BACKEND/app/domain/audit.py")")"
expect "verify-gate blocks when the gate ran only before the last edit" 2 verify-gate "$(stop_payload "$T")"

T="$(tx backend-api \
    "$(t_edit "$BACKEND/app/api/product.py")" \
    "$(t_bash "ruff check app tests && black --check app tests && pytest")")"
expect_output "verify-gate demands the contract check after a route edit" "export_openapi" verify-gate "$(stop_payload "$T")"

T="$(tx backend-docs "$(t_edit "$BACKEND/docs/notes.md")")"
expect "verify-gate ignores a backend docs-only edit" 0 verify-gate "$(stop_payload "$T")"

T="$(tx frontend-unverified "$(t_edit "$FRONTEND/src/features/alerts.tsx")")"
expect_output "verify-gate names npm run verify for a frontend edit" "npm run verify" verify-gate "$(stop_payload "$T")"

T="$(tx frontend-verified "$(t_edit "$FRONTEND/src/features/alerts.tsx")" "$(t_bash "npm run verify")")"
expect "verify-gate allows a frontend edit followed by verify" 0 verify-gate "$(stop_payload "$T")"

T="$(tx other "$(t_edit "$OTHER/src/index.ts")")"
expect "verify-gate ignores an unrelated repository" 0 verify-gate "$(stop_payload "$T")"

T="$(tx active "$(t_edit "$BACKEND/app/domain/audit.py")")"
expect "verify-gate never blocks twice in a row" 0 verify-gate "$(stop_payload "$T" true)"

expect "verify-gate allows a missing transcript" 0 verify-gate "$(stop_payload "$FIX/nope.jsonl")"

# On Windows both transcript_path and every edited file_path arrive as doubled
# backslashes; neither may be mistaken for "no transcript" or "no repository".
if [ -n "$(win "$BACKEND")" ]; then
    T="$(tx windows "$(t_edit "$(win "$BACKEND")\\\\app\\\\domain\\\\audit.py")")"
    expect "verify-gate blocks with Windows transcript and file paths" 2 verify-gate "$(stop_payload "$(win "$T")")"
else
    skip "verify-gate blocks with Windows transcript and file paths"
fi

T="$(tx launcher "$(t_edit "$BACKEND/app/domain/audit.py")")"
expect_via_launcher "verify-gate blocks through run-hook.cmd" 2 verify-gate "$(stop_payload "$T")"

# ---------------------------------------------------------------------------

printf '\n%s passed, %s failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
