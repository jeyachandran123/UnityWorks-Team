#!/usr/bin/env bash
# PreToolUse: block edits to the migrated-verbatim trees of the Vision AI backend.
#
# vision_os/ is byte-identical to its source and compliance/ and tools/ are
# excluded from lint for the same reason. A test proves the dependency arrow, but
# no test proves you MEANT to edit here. This asks for that intent explicitly.
#
# Scoped to the repository that holds both vision_os/ and
# scripts/export_openapi.py, so an unrelated project's tools/ is never touched.

set -uo pipefail

payload="$(cat)"
. "$(dirname "$0")/lib/common"

path="$(normalise_path "$(json_field file_path)")"
[ -n "$path" ] || exit 0

root="$(repo_root_of "$path")" || exit 0
is_vision_backend "$root" || exit 0

case "${path#"$root"/}" in
    vision_os/*|compliance/*|tools/*)
        cat >&2 <<MSG
BLOCKED: $path is inside a migrated-verbatim tree.

vision_os/, compliance/ and tools/ are moved unchanged from their source and are
excluded from lint for that reason. Editing here breaks the migration invariant
asserted by tests/app/test_migration.py.

If the change is genuinely required, stop and ask the user to confirm it
explicitly, so it is made deliberately rather than incidentally.
MSG
        exit 2
        ;;
esac

exit 0
