#!/usr/bin/env bash
# PreToolUse: block edits under paths a project declares protected.
#
#   protect        = <path-prefix> :: <why>
#   protect-except = <path-prefix>
#
# in the repository's .claude/team.conf. A repository without team.conf, or a
# file outside every declared prefix, is never touched.

set -uo pipefail

payload="$(cat)"
. "$(dirname "$0")/lib/common"

path="$(normalise_path "$(json_field file_path)")"
[ -n "$path" ] || exit 0
root="$(repo_root_of "$path")" || exit 0
team_conf "$root" >/dev/null || exit 0

rel="${path#"$root"/}"

while IFS= read -r exempt; do
    under "$rel" "$exempt" && exit 0
done < <(conf_values "$root" protect-except)

while IFS= read -r entry; do
    prefix="$(part 1 "$entry")"
    why="$(rest_from 2 "$entry")"
    if under "$rel" "$prefix"; then
        cat >&2 <<MSG
BLOCKED: $rel is inside a protected path ($prefix).

${why:-This project marks it protected in .claude/team.conf.}

If the change is genuinely required, stop and ask the user to confirm it
explicitly, so it is made deliberately rather than incidentally.
MSG
        exit 2
    fi
done < <(conf_values "$root" protect)

exit 0
