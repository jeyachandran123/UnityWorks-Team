#!/usr/bin/env bash
# PreToolUse guard: refuse to write a secret into the repository.
#
# .env is gitignored in both repos, but nothing stops a key landing in a .py or
# .ts file, and a secret is unrecoverable once pushed — rewriting history does
# not un-leak it. Blocking the write is the only cheap moment.
#
# Exit 2 blocks the tool call and returns stderr to Claude.

set -uo pipefail

payload="$(cat)"

# Extract a JSON string field without requiring jq (not present on all machines).
field() {
    printf '%s' "$payload" \
        | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\(\([^\"\\\\]\|\\\\.\)*\)\".*/\1/p" \
        | head -1
}

path="$(field file_path)"
content="$(printf '%s' "$payload" | tr -d '\n')"

case "$path" in
    *.env.example|*.env.sample|*.env.template) exit 0 ;;
    *.env|*.env.*)
        echo "BLOCKED: $path is an environment file. Secrets belong in your shell or a secret store, never in the tree. Edit .env.example instead." >&2
        exit 2
        ;;
esac

# AWS access key IDs — a fixed, unmistakable prefix and length.
if printf '%s' "$content" | grep -Eq '(AKIA|ASIA)[0-9A-Z]{16}'; then
    echo "BLOCKED: content looks like an AWS access key ID. Load it from the environment instead." >&2
    exit 2
fi

# Private key blocks.
if printf '%s' "$content" | grep -q 'BEGIN [A-Z ]*PRIVATE KEY'; then
    echo "BLOCKED: content contains a private key block." >&2
    exit 2
fi

# A long hex or base64-ish literal assigned to a secret-shaped name. The name
# requirement is what keeps this from firing on hashes in test fixtures.
# $content is the raw JSON payload text, so a quote inside the tool's
# "content" field still carries the JSON string-escaping backslash in front
# of it (`\"`, not `"`) — the bracket expression makes that backslash
# optional so the pattern matches whichever form actually appears.
#
# The leading \b requires the keyword to START an identifier, not merely
# appear as a substring inside one. Without it, `expected_password_hash`
# (contains "password") and `BUILD_TOKEN` (contains "token") both looked
# secret-shaped and got blocked, even though a hash or a commit hash
# assigned to a name that says what it is is exactly the kind of legitimate
# content a test fixture or build script needs to write. `_` counts as a
# word character, so `\b` does not fire between the `_` and the keyword in
# either name — only a keyword that leads its own identifier (`SECRET_KEY`,
# `API_KEY`, ...) still matches.
if printf '%s' "$content" \
    | grep -Eqi '\b(secret|token|password|api_?key)[a-z_]*[[:space:]]*[:=][[:space:]]*[\\]?"[A-Za-z0-9+/_-]{32,}[\\]?"'; then
    echo "BLOCKED: content assigns a long literal to a secret-shaped name. Read it from settings/env instead." >&2
    exit 2
fi

exit 0
