#!/usr/bin/env bash
# PreToolUse: block commands whose damage cannot be undone by a later test run.

set -uo pipefail

payload="$(cat)"
. "$(dirname "$0")/lib/common"

command_text="$(json_field command)"

block() {
    printf 'BLOCKED: %s\n\n%s\n\nIf this is genuinely intended, ask the user to run it themselves.\n' "$1" "$2" >&2
    exit 2
}

case "$command_text" in
    *"alembic downgrade"*)
        block "alembic downgrade" \
"Downgrades drop columns and partitions. Restore from a backup or write a new
forward migration instead."
        ;;
    *"push --force"*|*"push -f"*)
        block "force push" \
"Both repositories work on shared feature branches. Rewriting published history
loses commits that may exist nowhere else."
        ;;
    *"git checkout -- ."*|*"git checkout ."*|*"git restore ."*|*"git reset --hard"*|*"git clean -f"*)
        block "discarding the working tree" \
"Uncommitted work has no recovery path once this runs. Commit or stash it first."
        ;;
    *"compose down"*)
        block "docker compose down" \
"It recreates the database container and has already destroyed a database in
this workspace once. Use restart, stop or up -d."
        ;;
esac

exit 0
