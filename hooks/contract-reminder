#!/usr/bin/env bash
# PostToolUse: after a backend route edit, name the two follow-up commands.
#
# Advisory by design — PostToolUse runs after the edit has already succeeded and
# cannot block. What it prevents is not a bad edit but a forgotten second step in
# a different repository, which no test in either repo can observe.

set -uo pipefail

payload="$(cat)"
. "$(dirname "$0")/lib/common"

path="$(normalise_path "$(json_field file_path)")"
[ -n "$path" ] || exit 0

root="$(repo_root_of "$path")" || exit 0
is_vision_backend "$root" || exit 0

case "${path#"$root"/}" in
    app/api/*)
        cat >&2 <<'MSG'
Route surface changed. The frontend is typed from the committed schema, so two
commands must follow or the contract silently drifts:

    python scripts/export_openapi.py
    cd ../unityworks-vision-ai-frontend && npm run types:generate

Procedure: unityworks-team:contract-sync
MSG
        ;;
esac

exit 0
