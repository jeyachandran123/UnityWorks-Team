#!/usr/bin/env bash
# Stop: refuse to finish once when this session edited gated code and never ran
# the project's gate for it afterwards.
#
#   gate = <watched path prefixes, space-separated> :: <text that proves it ran> :: <command to run>
#
# e.g. gate = src/ tests/ :: npm run verify :: npm run verify
#
# "Verify before claiming done" is otherwise a rule followed by judgment, and
# judgment is what fails at the end of a long session. It reads the session
# transcript rather than git status, so work already uncommitted when the
# session started does not trip it. It blocks at most once: with
# stop_hook_active the assistant has already been told, and blocking again
# would loop.

set -uo pipefail

payload="$(cat)"
. "$(dirname "$0")/lib/common"

case "$payload" in
    *'"stop_hook_active":true'*|*'"stop_hook_active": true'*) exit 0 ;;
esac

transcript="$(normalise_path "$(json_field transcript_path)")"
[ -f "$transcript" ] || exit 0

# line-number<TAB>file_path for every Edit/Write/MultiEdit tool call.
edits="$(grep -n -o '"name":"\(Edit\|Write\|MultiEdit\)","input":{"file_path":"[^"]*"' "$transcript" \
    | sed 's/^\([0-9]*\):.*"file_path":"\([^"]*\)"$/\1\t\2/')"
[ -n "$edits" ] || exit 0

# last_command_line <text> — last transcript line whose Bash or PowerShell
# command contains <text>. The command body may hold escaped quotes (\"), so it
# is matched as a run of non-quote characters or backslash escapes.
last_command_line() {
    grep -n -o '"name":"\(Bash\|PowerShell\)","input":{"command":"\([^"\\]\|\\.\)*'"$1" "$transcript" \
        | tail -1 | cut -d: -f1
}

# For every (repository, gate) pair touched: the last transcript line that
# edited a watched path. Kept as "root<TAB>gate-index<TAB>line" records.
records=""
while IFS="$(printf '\t')" read -r line raw; do
    path="$(normalise_path "$raw")"
    root="$(repo_root_of "$path")" || continue
    team_conf "$root" >/dev/null || continue
    rel="${path#"$root"/}"
    i=0
    while IFS= read -r entry; do
        i=$((i + 1))
        # shellcheck disable=SC2046  # watched prefixes are space-separated by design
        if under "$rel" $(part 1 "$entry"); then
            records="$(printf '%s\n%s\t%s\t%s' "$records" "$root" "$i" "$line")"
        fi
    done < <(conf_values "$root" gate)
done <<EOF
$edits
EOF
[ -n "$records" ] || exit 0

messages=""
while IFS="$(printf '\t')" read -r root index last_edit; do
    [ -n "$root" ] || continue
    entry="$(conf_values "$root" gate | sed -n "${index}p")"
    evidence="$(part 2 "$entry")"
    command="$(part 3 "$entry")"
    ran="$(last_command_line "$evidence")"
    if [ -z "$ran" ] || [ "$ran" -lt "$last_edit" ]; then
        messages="${messages}  $(basename "$root"): ${command:-$evidence}
"
    fi
done < <(printf '%s\n' "$records" | sort -t "$(printf '\t')" -k1,1 -k2,2n -k3,3nr | sort -u -t "$(printf '\t')" -k1,1 -k2,2)

[ -n "$messages" ] || exit 0

cat >&2 <<MSG
NOT DONE YET — this session edited gated code, and these gates never ran after the last edit:

${messages}
Run them and report their real output. If one genuinely cannot run here, say so
plainly and say why, instead of claiming the work is complete.
MSG
exit 2
