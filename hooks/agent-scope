#!/usr/bin/env bash
# PreToolUse: keep specialist agents advisory.
#
# Applies to this plugin's agents (agent_type "unityworks-team:<role>") and to
# any project agent a repository names in .claude/team.conf:
#
#   agent = <agent name>
#
# Those agents need Write (to file a report) and Bash (to run tests), and both
# can mutate. A permission deny-list in settings.json cannot say "only for
# these agents" — it binds the main session too. This hook can, because Claude
# Code names the subagent in the payload.
#
#   - Write/Edit only under the repository's reviews directory
#     (reviews = <dir>, default docs/reviews) or inside a scratch copy
#   - no git history or working-tree changes, no dependency installs
#   - plus per project:  advisor-block = <command substring> :: <why>
#                        advisor-allow = <command substring>   (overrides advisor-block)

set -uo pipefail

payload="$(cat)"
. "$(dirname "$0")/lib/common"

agent="$(json_field agent_type)"
[ -n "$agent" ] || exit 0

cwd="$(normalise_path "$(json_field cwd)")"
[ -n "$cwd" ] || cwd="$PWD"
cwd_root="$(repo_root_of "$cwd")" || cwd_root=""

case "$agent" in
    unityworks-team:*) ;;
    *)
        [ -n "$cwd_root" ] || exit 0
        conf_values "$cwd_root" agent | grep -qxF "$agent" || exit 0
        ;;
esac

block() {
    printf 'BLOCKED for %s: %s\n\nSpecialists advise; the main session implements. %s\n' "$agent" "$1" "$2" >&2
    exit 2
}

tool="$(json_field tool_name)"
case "$tool" in
    Write|Edit|MultiEdit|NotebookEdit)
        path="$(normalise_path "$(json_field file_path)")"
        [ -n "$path" ] || path="$(normalise_path "$(json_field notebook_path)")"

        # Inside a copy made by skills/invariant-audit/scratch-copy.
        dir="$(dirname "$path")"
        while [ -n "$dir" ] && [ "$dir" != "/" ] && [ "$dir" != "." ]; do
            [ -f "$dir/.unityworks-scratch-copy" ] && exit 0
            parent="$(dirname "$dir")"; [ "$parent" = "$dir" ] && break; dir="$parent"
        done

        if root="$(repo_root_of "$path")"; then
            reviews="$(conf_value "$root" reviews docs/reviews)"
            under "${path#"$root"/}" "${reviews%/}/" && exit 0
        fi
        block "writing $path" \
"Reports go to <reviews>/<date>/<role>.md. Put the proposed change in the
report's Recommendation instead."
        ;;
    Bash|PowerShell)
        cmd="$(json_field command)"
        case "$cmd" in
            *"git commit"*|*"git push"*|*"git checkout"*|*"git switch"*|*"git reset"*|*"git restore"*|\
            *"git clean"*|*"git stash"*|*"git merge"*|*"git rebase"*|*"git cherry-pick"*|*"git am "*|\
            *"git apply"*|*"git rm "*|*"git mv "*|*"git branch -d"*|*"git branch -D"*|*"git tag "*|\
            *"git worktree add"*|*"git worktree remove"*)
                block "git state change: $cmd" \
"Read history with git log/show/diff/status. For mutation testing use the
invariant-audit scratch-copy helper, which needs no git."
                ;;
            *"npm install"*|*"npm i "*|*"npm ci"*|*"npm uninstall"*|*"npm update"*|\
            *"pnpm add"*|*"pnpm install"*|*"yarn add"*|*"pip install"*|*"pip uninstall"*|*"uv pip"*|*"poetry add"*)
                block "dependency change: $cmd" "Report the missing dependency instead."
                ;;
        esac
        [ -n "$cwd_root" ] || exit 0
        while IFS= read -r allowed; do
            [ -n "$allowed" ] && case "$cmd" in *"$allowed"*) exit 0 ;; esac
        done < <(conf_values "$cwd_root" advisor-allow)
        while IFS= read -r entry; do
            pattern="$(part 1 "$entry")"
            [ -n "$pattern" ] || continue
            case "$cmd" in *"$pattern"*) block "$pattern" "$(rest_from 2 "$entry")" ;; esac
        done < <(conf_values "$cwd_root" advisor-block)
        ;;
esac

exit 0
