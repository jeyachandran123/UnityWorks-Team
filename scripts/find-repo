#!/usr/bin/env bash
# find-repo <kind> [start-dir] — print the root of the repository whose
# .claude/team.conf declares "kind = <kind>". Never by folder name or location.
#
# Search order from start-dir (default: current directory), nearest first:
#   1. the repository containing start-dir
#   2. repositories up to two levels below start-dir
#   3. repositories beside (1), then up to two levels below its grandparent
# Exit 1 with a message when nothing matches. Exit 2 when two or more match at
# the nearest level that has a match — it never silently picks one.

set -uo pipefail
. "$(cd "$(dirname "$0")/../hooks/lib" && pwd)/common"

kind="${1:?usage: find-repo <kind> [start-dir]}"
start="$(cd "${2:-$PWD}" 2>/dev/null && pwd)" || { echo "find-repo: no such directory: ${2:-}" >&2; exit 1; }

is_kind() { [ "$(conf_value "$1" kind)" = "$kind" ]; }

# repositories <dir> <depth> — directories holding .git, at or below dir.
repositories() {
    [ -d "$1" ] || return 0
    find "$1" -mindepth 0 -maxdepth "$2" \
        \( -name node_modules -o -name .venv -o -name venv -o -name .git \) -prune -o \
        -type d -print 2>/dev/null \
        | while IFS= read -r d; do [ -e "$d/.git" ] && printf '%s\n' "$d"; done
}

# search <dir> <depth> — on a unique match print it and exit 0; on several,
# list them and exit 2; otherwise return 1 so the next level is tried.
search() {
    local matches=() d count
    while IFS= read -r d; do
        is_kind "$d" && matches+=("$d")
    done < <(repositories "$1" "$2" | sort -u)
    count="${#matches[@]}"
    if [ "$count" -eq 1 ]; then
        printf '%s\n' "${matches[0]}"
        exit 0
    elif [ "$count" -gt 1 ]; then
        printf 'find-repo: more than one repository of kind %s:\n' "$kind" >&2
        printf '  %s\n' "${matches[@]}" >&2
        printf 'Run from inside the one you mean, or pass it as start-dir.\n' >&2
        exit 2
    fi
    return 1
}

own="$(repo_root_of "$start")" || own=""
if [ -n "$own" ] && is_kind "$own"; then
    printf '%s\n' "$own"
    exit 0
fi

search "$start" 2

anchor="${own:-$start}"
parent="$(dirname "$anchor")"
search "$parent" 1
search "$(dirname "$parent")" 2

echo "find-repo: no repository with 'kind = $kind' in .claude/team.conf near $start" >&2
exit 1
