# Sourced. Sets BACKEND and FRONTEND to the Vision AI repositories, found by
# their contents (scripts/find-repo), never by folder name — renaming or moving
# either checkout does not break anything that sources this.
#
#   . locate-pair            set the variables (exit 1 with a message if not found)
#   bash locate-pair --print print "export BACKEND=… FRONTEND=…" for eval, e.g. in a skill:
#                            eval "$(bash <plugin>/scripts/locate-pair --print)"

# to_native <path> — a path node/python on Windows can open.
to_native() {
    if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi
}

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BACKEND="$(bash "$_here/find-repo" vision-backend)" || exit 1
FRONTEND="$(bash "$_here/find-repo" vision-frontend "$BACKEND/..")" \
    || FRONTEND="$(bash "$_here/find-repo" vision-frontend)" || exit 1

# The frontend generator's default schema path is the sibling folder
# ../unityworks-vision-ai-backend. Pointing UWV_SCHEMA_PATH at the backend we
# actually found keeps types:check correct whatever the folders are called.
export UWV_SCHEMA_PATH="${UWV_SCHEMA_PATH:-$(to_native "$BACKEND/docs/api/openapi.json")}"

backend_python() {
    if [ -x "$BACKEND/.venv/Scripts/python.exe" ]; then
        printf '%s' "$BACKEND/.venv/Scripts/python.exe"
    elif [ -x "$BACKEND/.venv/bin/python" ]; then
        printf '%s' "$BACKEND/.venv/bin/python"
    else
        command -v python3 || command -v python
    fi
}

if [ "${1:-}" = "--print" ]; then
    printf 'export BACKEND=%q FRONTEND=%q UWV_SCHEMA_PATH=%q\n' "$BACKEND" "$FRONTEND" "$UWV_SCHEMA_PATH"
fi
