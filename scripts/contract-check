#!/usr/bin/env bash
# contract-check — run the OpenAPI seam end to end without changing any file.
#
#   1. backend:  export_openapi.py --check   (routes vs committed export)
#   2. frontend: types:check                  (committed export vs committed types)
#   3. frontend: types:check against the CI pin, exactly as CI does
#
# Exit 0 only when all three pass. Each step prints PASS/FAIL and its tail.

set -uo pipefail
. "$(dirname "$0")/locate-pair"

status=0
step() {
    local name="$1"; shift
    local out rc
    out="$("$@" 2>&1)"; rc=$?
    if [ "$rc" -eq 0 ]; then
        printf 'PASS  %s\n' "$name"
    else
        printf 'FAIL  %s (exit %s)\n' "$name" "$rc"
        printf '%s\n' "$out" | tail -8 | sed 's/^/      /'
        status=1
    fi
}

PY="$(backend_python)"
step "backend export is current (export_openapi.py --check)" \
    bash -c "cd \"$BACKEND\" && \"$PY\" scripts/export_openapi.py --check"

step "frontend types match the sibling backend export (types:check)" \
    bash -c "cd \"$FRONTEND\" && npm run --silent types:check"

pin="$(tr -d '[:space:]' < "$FRONTEND/.github/backend-schema.sha" 2>/dev/null || true)"
if [ -z "$pin" ]; then
    printf 'FAIL  CI pin: .github/backend-schema.sha is missing or empty\n'
    status=1
else
    tmp="$(mktemp -d)"
    if git -C "$BACKEND" show "$pin:docs/api/openapi.json" > "$tmp/openapi.json" 2>/dev/null; then
        step "frontend types match the CI-pinned schema ($(printf '%.7s' "$pin"))" \
            bash -c "cd \"$FRONTEND\" && UWV_SCHEMA_PATH=\"$(to_native "$tmp/openapi.json")\" npm run --silent types:check"
        if ! git -C "$BACKEND" branch -r --contains "$pin" 2>/dev/null | grep -q .; then
            printf 'FAIL  CI pin %.7s is not on any remote branch — CI cannot fetch it\n' "$pin"
            status=1
        fi
    else
        printf 'FAIL  CI pin %s is not in the local backend history (fetch the backend?)\n' "$pin"
        status=1
    fi
    rm -rf "$tmp"
fi

if [ "$status" -ne 0 ]; then
    printf '\nProcedure: unityworks-team:contract-sync\n'
fi
exit "$status"
