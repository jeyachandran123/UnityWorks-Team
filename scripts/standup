#!/usr/bin/env bash
# standup — git state of this repository and its related repositories, review
# status, and what the project declares. Read-only: runs no tests or checks,
# fetches nothing, changes nothing.

set -uo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/../hooks/lib/common"

context="$(bash "$here/team-context")" || exit 1
eval "$context"

repos="$REPO_SELF"
while IFS='=' read -r var _; do
    case "$var" in REPO_SELF) ;; REPO_*) repos="$repos
${!var}" ;; esac
done <<<"$context"

section() { printf '\n## %s\n' "$1"; }

while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    section "$(basename "$repo")$( [ "$repo" = "$REPO_SELF" ] && printf ' (this repository)')"
    printf 'path:     %s\n' "$repo"
    printf 'branch:   %s\n' "$(git -C "$repo" branch --show-current)"
    printf 'head:     %s\n' "$(git -C "$repo" log -1 --format='%h %s (%cr)' 2>/dev/null || echo 'no commits')"
    upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    if [ -n "$upstream" ]; then
        read -r behind ahead < <(git -C "$repo" rev-list --left-right --count "$upstream...HEAD")
        printf 'upstream: %s — ahead %s, behind %s (as of last fetch)\n' "$upstream" "$ahead" "$behind"
    else
        printf 'upstream: none — branch is not pushed\n'
    fi
    default="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    [ -n "$default" ] || { git -C "$repo" rev-parse -q --verify origin/main >/dev/null && default=origin/main; }
    [ -n "$default" ] && printf 'vs %s: %s commits not on it\n' "$default" "$(git -C "$repo" rev-list --count "$default..HEAD")"

    changes="$(git -C "$repo" status --short)"
    if [ -n "$changes" ]; then
        printf 'uncommitted (%s):\n' "$(printf '%s\n' "$changes" | wc -l | tr -d ' ')"
        printf '%s\n' "$changes" | head -25 | sed 's/^/  /'
    else
        printf 'uncommitted: none\n'
    fi

    reviews_dir="$repo/$(conf_value "$repo" reviews docs/reviews)"
    latest="$(ls -d "$reviews_dir"/*/ 2>/dev/null | sort | tail -1)"
    if [ -n "$latest" ]; then
        printf 'latest review: %s\n' "${latest#"$repo"/}"
        if [ -f "$latest/00-triage.md" ]; then
            grep -m1 -A1 '^# Verdict' "$latest/00-triage.md" | tail -1 | sed 's/^/  verdict: /'
        else
            printf '  untriaged reports: %s\n' "$(ls "$latest" | tr '\n' ' ')"
        fi
        printf '  blocker findings filed: %s\n' \
            "$(grep -h -c '^\- \*\*Severity:\*\* blocker' "$latest"/*.md 2>/dev/null | awk '{s+=$1} END {print s+0}')"
    else
        printf 'latest review: none\n'
    fi
done <<<"$repos"

section "team configuration"
if [ "$TEAM_CONFIGURED" = yes ]; then
    printf 'name: %s   kind: %s\n' "$TEAM_NAME" "${TEAM_KIND:-(none)}"
    checks="$(conf_values "$REPO_SELF" check | while IFS= read -r e; do printf '%s ' "$(part 1 "$e")"; done)"
    printf 'checks: %s\n' "${checks:-none declared}"
    printf 'gates: %s   protected paths: %s   generated files: %s\n' \
        "$(conf_values "$REPO_SELF" gate | grep -c .)" "$(conf_values "$REPO_SELF" protect | grep -c .)" \
        "$(conf_values "$REPO_SELF" generated | grep -c .)"
    [ -n "$TEAM_MISSING" ] && printf 'RELATED REPOSITORIES NOT FOUND: %s\n' "$TEAM_MISSING"
else
    printf 'NOT CONFIGURED — no .claude/team.conf. Run /team-init to set this project up.\n'
fi

exit 0
